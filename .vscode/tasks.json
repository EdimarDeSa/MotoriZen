{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Launch Docker",
      "type": "shell",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "command": "docker-compose -f docker/compose.yaml up redis keycloak postgres -d"
    },
    {
      "label": "Stop Docker",
      "type": "shell",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "command": "docker-compose -f docker/compose.yaml down"
    }
  ]
}
